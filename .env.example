# Secrets belong in ignored .env.local; never in browser code or git.
# Offline testing / demo:
# AI_SHARK_TANK_MODE=mock
# PORT=5050
# AI_SHARK_TANK_STATS_PATH=./data/all-time-stats.json
# Live mode requires both keys in the server environment:
# OPENAI_API_KEY=...
# ANTHROPIC_API_KEY=...
# AI_SHARK_TANK_MODE=live
# OpenAI: gpt-6.1-sol / medium / ultrafast
# Anthropic: claude-sonnet-5-5 / medium
# All live speech: gpt-4o-mini-tts (seven stock voices, no clones)
# Automated and manual tests must remain scripted/offline.
